# ==============================================================================
# CyberSage AI - Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# Backend API Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ChromaDB / RAG Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
PLAYBOOKS_DIRECTORY=../knowledge_base/playbooks
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional n8n Webhook Notification Configuration
N8N_WEBHOOK_URL=
N8N_WEBHOOK_BEARER_TOKEN=
